# @tailwindcss/oxide-wasm32-wasi is intentionally installed even though its
# declared platform (wasm32) doesn't match the host CPU (x64/arm64) — it's
# only ever loaded as a WASI fallback (see package.json's "dev"/"build"
# scripts: NAPI_RS_FORCE_WASI=true) for environments where the native
# @tailwindcss/oxide binary can't load (e.g. Windows machines whose
# Application Control / WDAC policy blocks native .node files in
# node_modules). npm's default platform check would otherwise refuse to
# install it at all.
force=true
