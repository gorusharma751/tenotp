PORT=8787
APP_URL=http://localhost:5173

# Frontend origin(s) allowed to call this API (CORS). Comma-separated.
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB — required for everything.
MONGODB_URI=
MONGODB_DB_NAME=tenotp

# Auth (JWT bearer tokens returned to the frontend on login/signup)
AUTH_JWT_SECRET=

# Telegram Mini App login — the bot token from @BotFather (BotFather >
# /mybots > your bot > API Token). Required for POST /api/auth/telegram;
# without it the endpoint just returns an error, everything else works fine.
TELEGRAM_BOT_TOKEN=

PAYMENT_PROVIDER=bharatpe
PAYMENT_ENCRYPTION_KEY=

# Cron / scheduled sync hooks
CRON_SECRET=

# SMS/OTP upstream providers
GRIZZLYSMS_API_KEY=
TIGERSMS_API_KEY=
SMSBOWER_API_KEY=
SASTASMS_API_KEY=
FIVESIM_API_KEY=

# Razorpay (optional env fallback — the admin panel can set these instead)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
